---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FloatingWhatsApp from "../components/FloatingWhatsApp.astro";
import { organizationSchema, site } from "../config/site.mjs";
import "../styles/global.css";
import "../styles/brand-overrides.css";

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  image = "/og-default.svg",
  schema = [],
  bodyClass = "",
  type = "website",
} = Astro.props;
const canonical = new URL(canonicalPath, site.domain).toString();
const socialImage = new URL(image, site.domain).toString();
const schemas = [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])].filter(Boolean);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1220" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    {schemas.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Lewati ke isi utama</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <FloatingWhatsApp />
    <div class="live-region sr-only" aria-live="polite" aria-atomic="true" data-live-region></div>
    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
