---
interface Props {
  compact?: boolean;
  inverse?: boolean;
}

const { compact = false, inverse = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const emblemSrc = `${base}brand/hr-emblem.png`;
---
<span class:list={["brand-lockup", { "is-compact": compact, "is-inverse": inverse }]} aria-label="HR Production">
  <span class="brand-monogram" aria-hidden="true">
    <img src={emblemSrc} alt="HR Production" width="48" height="48" class="brand-emblem-img" loading="eager" decoding="async" />
  </span>
  {!compact && (
    <span class="brand-copy">
      <strong>HR PRODUCTION</strong>
      <span>Event Rental &amp; Production</span>
    </span>
  )}
</span>
