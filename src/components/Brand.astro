---
const { compact = false, inverse = false } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const src = compact ? `${base}brand/hr-mark.svg` : `${base}brand/hr-production-logo.svg`;
---
<span class:list={["brand-lockup", { "is-compact": compact, "is-inverse": inverse }]}>
  <img src={src} width={compact ? 52 : 260} height={52} alt="HR Production" decoding="async" />
</span>
