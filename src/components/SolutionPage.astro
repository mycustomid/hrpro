---
import BaseLayout from "../layouts/BaseLayout.astro";
import FinalCTA from "./FinalCTA.astro";
import { formatIDR } from "../lib/catalog.mjs";
import { site } from "../config/site.mjs";
import "../styles/solution.css";

interface Product { id: string; name: string; image: string; price: number; category: string; }
interface Need { title: string; body: string; }
interface Response { step: string; body: string; }
interface Props { eyebrow: string; title: string; intro: string; description: string; canonicalPath: string; needs: Need[]; response: Response[]; products: Product[]; catalogQuery: string; schemaName: string; schemaDescription: string; signal: string; }
const { eyebrow, title, intro, description, canonicalPath, needs, response, products, catalogQuery, schemaName, schemaDescription, signal } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: schemaName, description: schemaDescription, provider: { "@type": "Organization", name: site.name, url: site.domain }, areaServed: site.serviceArea, serviceType: schemaName }, { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Beranda", item: `${site.domain}/` }, { "@type": "ListItem", position: 2, name: schemaName, item: `${site.domain}${canonicalPath}` }] }];
---
<BaseLayout title={`${schemaName} | HR Production`} description={description} canonicalPath={canonicalPath} schema={schema} bodyClass={`solution-page solution-${signal}`}>
  <nav class="breadcrumb" aria-label="Breadcrumb"><ol class="page-shell"><li><a href={path("/")}>Beranda</a></li><li aria-current="page">{schemaName}</li></ol></nav>
  <header class="solution-hero"><div class="page-shell solution-hero-grid"><div><p class="eyebrow">{eyebrow}</p><h1>{title}</h1></div><div class="solution-intro"><span>Operational brief / 01</span><p>{intro}</p><a class="button button-ink" href={`${path("/katalog")}${catalogQuery}`}>Lihat inventaris relevan <span aria-hidden="true">→</span></a></div></div><div class="solution-hero-objects page-shell" aria-label="Pilihan inventaris untuk solusi ini">{products.slice(0, 3).map((product, index) => <figure class={`solution-object object-${index + 1}`}><span>0{index + 1}</span><img src={path(product.image)} width="329" height="224" alt={product.name} /><figcaption>{product.name}</figcaption></figure>)}</div></header>
  <section class="solution-risks section" aria-labelledby="risk-title"><div class="page-shell"><div class="section-intro"><p class="eyebrow">Yang perlu dikendalikan</p><div><h2 id="risk-title">Detail kecil menjadi risiko besar saat acaranya dimulai.</h2><p class="section-intro-copy">Kami memetakan kebutuhan berdasarkan alur tamu, fungsi ruang, prioritas protokol, dan waktu kerja venue.</p></div></div><div class="needs-grid">{needs.map((need, index) => <article data-reveal><span>0{index + 1}</span><h3>{need.title}</h3><p>{need.body}</p></article>)}</div></div></section>
  <section class="solution-response section section-dark" aria-labelledby="response-title"><div class="page-shell"><div class="section-intro"><p class="eyebrow">Cara kami merespons</p><div><h2 id="response-title">Rencana yang dapat dibaca tim lapangan.</h2><p class="section-intro-copy">Bukan sekadar daftar barang: urutannya mengikuti keputusan yang perlu dikunci sebelum hari pelaksanaan.</p></div></div><ol class="response-list">{response.map((item, index) => <li data-reveal><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{item.step}</h3><p>{item.body}</p></div></li>)}</ol></div></section>
  <section class="solution-inventory section section-paper" aria-labelledby="solution-inventory-title"><div class="page-shell"><div class="inventory-solution-heading"><div><p class="eyebrow">Inventory edit</p><h2 id="solution-inventory-title">Pilihan yang masuk akal untuk brief ini.</h2></div><a class="text-link" href={`${path("/katalog")}${catalogQuery}`}>Buka katalog terfilter <span aria-hidden="true">→</span></a></div><div class="solution-products">{products.map((product, index) => <article><div><span>0{index + 1} · {product.category}</span><img src={path(product.image)} width="329" height="224" loading="lazy" decoding="async" alt={product.name} /></div><h3>{product.name}</h3><p>Mulai {formatIDR(product.price)}</p></article>)}</div></div></section>
  <section class="brief-checklist section section-signal"><div class="page-shell brief-grid"><div><p class="eyebrow">Siapkan sebelum menghubungi</p><h2>Empat data.<br/><em>Diskusi lebih cepat.</em></h2></div><ol><li><span>01</span>Jenis dan format acara</li><li><span>02</span>Tanggal serta jam akses venue</li><li><span>03</span>Lokasi dan kondisi loading</li><li><span>04</span>Jumlah tamu serta area prioritas</li></ol></div></section>
  <FinalCTA eyebrow="Bawa brief Anda" title="Mari ubah kebutuhan menjadi rencana kerja." body="Kirim konteks acara—kami bantu mengarahkan inventaris, jumlah, dan detail operasional yang perlu dikonfirmasi." message={`Halo HR Production, saya ingin berdiskusi tentang ${schemaName}. Jenis acara: — Tanggal: — Venue: — Jumlah tamu: —`} />
</BaseLayout>
