---
import { formatIDR } from "../../lib/catalog.mjs";
interface Product {
  image: string;
  name: string;
  price: number;
  tags: string[];
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = (value: string) => `${base}${value.replace(/^\//, "")}`;
---
<section class="section selected-inventory" aria-labelledby="inventory-title"><div class="page-shell"><div class="inventory-heading"><div><p class="eyebrow">Selected Inventory</p><h2 id="inventory-title">Benda biasa.<br/><em>Disiapkan dengan serius.</em></h2></div><a class="text-link" href={path("/katalog")}>Buka semua 84 produk <span aria-hidden="true">→</span></a></div><div class="inventory-editorial-grid">{products.map((product, index) => <article class={`inventory-feature inventory-feature-${index + 1}`} data-reveal><a href={`${path("/katalog")}?q=${encodeURIComponent(product.name)}`}><div class="inventory-media"><span class="inventory-no">{String(index + 1).padStart(2, "0")}</span><img src={path(product.image)} width="329" height="224" loading="lazy" decoding="async" alt={product.name} /></div><div class="inventory-caption"><div><h3>{product.name}</h3><p>{product.tags.join(" · ")}</p></div><span>Mulai {formatIDR(product.price)}</span></div></a></article>)}</div></div></section>
