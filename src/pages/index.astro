---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import ProofRail from "../components/home/ProofRail.astro";
import EventSolutions from "../components/home/EventSolutions.astro";
import SelectedInventory from "../components/home/SelectedInventory.astro";
import Process from "../components/home/Process.astro";
import Readiness from "../components/home/Readiness.astro";
import FinalCTA from "../components/FinalCTA.astro";
import catalogSource from "../data/catalog.json";
import { normalizeCatalog } from "../lib/catalog.mjs";
import "../styles/home.css";

const catalog = normalizeCatalog(catalogSource);
const byId = new Map(catalog.map((item) => [item.id, item]));
const select = (ids: string[]) => ids.map((id) => byId.get(id)).filter(Boolean);
const heroProducts = select(["sofa-single", "kursi-futura", "meja-dealing-kaca", "podium-lambang-garuda"]);
const featured = select(["sofa-single", "kursi-futura", "meja-dealing-kaca", "podium-lambang-garuda", "rope-stand-gold-vip"]);
---
<BaseLayout title="Sewa Furniture & Perlengkapan Event | HR Production" description="HR Production melayani konsultasi dan pemesanan sewa furniture, VIP seating, conference, exhibition, wedding, serta perlengkapan event untuk Jakarta, Tangerang Selatan, dan Jabodetabek." canonicalPath="/">
  <Hero products={heroProducts} />
  <ProofRail />
  <EventSolutions />
  <SelectedInventory products={featured} />
  <Process />
  <Readiness />
  <FinalCTA />
</BaseLayout>
