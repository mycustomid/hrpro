---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import ProofRail from "../components/home/ProofRail.astro";
import EventSolutions from "../components/home/EventSolutions.astro";
import SelectedInventory from "../components/home/SelectedInventory.astro";
import Process from "../components/home/Process.astro";
import Readiness from "../components/home/Readiness.astro";
import FinalCTA from "../components/FinalCTA.astro";
import catalogSource from "../data/catalog.json";
import { normalizeCatalog } from "../lib/catalog.mjs";
import "../styles/home.css";

const catalog = normalizeCatalog(catalogSource);
const byId = new Map(catalog.map((item) => [item.id, item]));
const select = (ids: string[]) => ids.map((id) => byId.get(id)).filter(Boolean);
const heroProducts = select(["sofa-oval-vip", "podium-lambang-garuda", "kursi-tiffany-gold", "meja-dealing-kaca-cover"]);
const featured = select(["sofa-oval-vip", "kursi-armchair-jokowi", "meja-dealing-kaca-cover", "podium-lambang-garuda", "tenda-sarnafil"]);
---
<BaseLayout title="HR Production | Infrastruktur Event Corporate, Pemerintah & Wedding" description="HR Production menyiapkan furniture, VIP seating, conference, exhibition, dan perlengkapan event untuk Jakarta, Tangerang Selatan, dan Jabodetabek." canonicalPath="/">
  <Hero products={heroProducts} />
  <ProofRail />
  <EventSolutions />
  <SelectedInventory products={featured} />
  <Process />
  <Readiness />
  <FinalCTA />
</BaseLayout>
