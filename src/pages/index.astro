---
import catalog from "../data/catalog.json";
import eventTypes from "../data/event_types.json";
import "../styles/global.css";

const base = import.meta.env.BASE_URL ?? "/";
const normalizedBase = base.endsWith("/") ? base : `${base}/`;
const withBase = (path) => (path.startsWith("/") ? `${normalizedBase}${path.slice(1)}` : `${normalizedBase}${path}`);

const waNumber = "6281381178127";
const waLink = (text) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
const formatPrice = (price) => `Rp ${price.toLocaleString("id-ID")}`;

const categoryOrder = ["Sofa", "Meja", "Kursi", "Perlengkapan"];
const categories = categoryOrder.filter((c) => catalog.some((item) => item.category === c));
const grouped = categories.map((name) => ({
  name,
  items: catalog.filter((item) => item.category === name),
}));

const filterChips = ["Semua", "Sofa", "Meja", "Kursi", "Perlengkapan", "VIP", "BUMN", "Wedding"];

const catalogByName = new Map(catalog.map((item) => [item.name, item]));
const featuredPackageIds = [
  "vvip-kenegaraan-bumn",
  "seminar-konferensi-100pax",
  "booth-pameran-expo",
  "gala-dinner",
];
const packages = featuredPackageIds
  .map((id) => eventTypes.find((e) => e.id === id))
  .filter(Boolean)
  .map((pkg) => {
    const items = pkg.recommended_items
      .map((name) => catalogByName.get(name))
      .filter(Boolean)
      .map((item) => ({ name: item.name, price: item.price }));
    const estimatedTotal = items.reduce((sum, item) => sum + item.price, 0);
    return { ...pkg, items, estimatedTotal };
  });

const pillars = [
  {
    title: "Unit Steril & Siap Pakai",
    desc: "Setiap unit dibersihkan dan diperiksa sebelum dikirim, tampil prima di hari H.",
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 5-3.5 8-7 10-3.5-2-7-5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>',
  },
  {
    title: "Armada Pengiriman Tepat Waktu 24/7",
    desc: "Pengiriman dan penjemputan terjadwal, siap dihubungi kapan saja.",
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16V7a1 1 0 0 1 1-1h9v10"/><path d="M13 10h4l3 3v3h-7"/><circle cx="7.5" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>',
  },
  {
    title: "Tim Loading Berpengalaman",
    desc: "Tim lapangan terlatih menangani setup dan bongkar muat dengan rapi dan aman.",
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="6" r="2.4"/><path d="M4 20v-2a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v2"/><circle cx="17.5" cy="8" r="2"/><path d="M15 20v-1.5a3.2 3.2 0 0 1 3.5-3.2c1.4 0 2.5.6 3 1.7"/></svg>',
  },
  {
    title: "Faktur Pajak & Invoice Resmi BUMN",
    desc: "Dokumen administrasi lengkap, sesuai standar pengadaan instansi dan korporasi.",
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l3 3v15H6z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>',
  },
];

const totalItems = catalog.length;
const phonePrimary = "+62 813-8117-8127";
const email = "hrproduction202@gmail.com";
const address = "Jl Beringin II RT 001/007 Pamulang Barat, Tangsel";
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="HR Production - pusat solusi stage, booth, VIP seating & event production. Vendor terpercaya BUMN dan instansi pemerintah."
    />
    <meta name="theme-color" content="#0a0e17" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>HR Production | Stage, Booth &amp; VIP Seating untuk Event Kenegaraan</title>
  </head>
  <body>
    <div class="bg-noise" aria-hidden="true"></div>

    <header class="site-header" id="top">
      <div class="container header-inner">
        <a class="brand" href="#top">
          <span class="brand-mark">HR</span>
          <span class="brand-text">
            <strong>HR PRODUCTION</strong>
            <span>Stage · Booth · VIP Seating · Event Production</span>
          </span>
        </a>
        <button class="nav-toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="siteNav" aria-label="Buka menu">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav" id="siteNav">
          <a href="#paket-event">Paket Event</a>
          <a href="#katalog">Katalog</a>
          <a href="#kepercayaan">Kepercayaan</a>
          <a href="#kontak">Kontak</a>
          <a
            class="btn btn-accent btn-sm"
            href={waLink("Halo HR Production, saya ingin tanya ketersediaan produk untuk event.")}
            target="_blank"
            rel="noreferrer"
          >
            Chat WhatsApp
          </a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-beams" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Pusat Solusi Event Production</p>
            <h1>Stage &amp; Booth <em>Kelas Kenegaraan</em></h1>
            <p class="lead">
              HR Production menyiapkan panggung, booth, dan VIP seating untuk BUMN, instansi
              pemerintah, dan korporasi — steril, tepat waktu, dan siap pakai.
            </p>
            <div class="hero-actions">
              <a class="btn btn-accent" href={withBase("/katalog.pdf")} target="_blank" rel="noreferrer">
                Download Katalog PDF
              </a>
              <button class="btn btn-ghost" id="heroSimulate" type="button">
                Simulasi Anggaran Event
              </button>
            </div>
            <div class="hero-stats">
              <div>
                <strong>{totalItems}+</strong>
                <span>Produk siap sewa</span>
              </div>
              <div>
                <strong>{categories.length} Kategori</strong>
                <span>Sofa, Meja, Kursi, Perlengkapan</span>
              </div>
              <div>
                <strong>&lt; 1 Jam</strong>
                <span>Respon WhatsApp tim kami</span>
              </div>
            </div>
          </div>

          <div class="hero-visual">
            <div class="hero-panel">
              <div class="hero-seal" aria-hidden="true">
                <svg viewBox="0 0 200 200">
                  <defs>
                    <path id="sealCircle" d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0" />
                  </defs>
                  <text font-size="10.6" letter-spacing="2.2">
                    <textPath href="#sealCircle" startOffset="0%">
                      VENDOR TERPERCAYA • BUMN &amp; INSTANSI PEMERINTAH • VENDOR TERPERCAYA • BUMN &amp; INSTANSI PEMERINTAH •
                    </textPath>
                  </text>
                </svg>
                <div class="hero-seal-core">✓</div>
              </div>
              <div class="hero-panel-info">
                <h2>Info Cepat</h2>
                <ul>
                  <li>
                    <span>Alamat</span>
                    <strong>{address}</strong>
                  </li>
                  <li>
                    <span>Telepon</span>
                    <strong>{phonePrimary}</strong>
                  </li>
                  <li>
                    <span>Email</span>
                    <strong>{email}</strong>
                  </li>
                </ul>
                <a
                  class="btn btn-dark btn-block"
                  href={waLink("Halo HR Production, saya ingin booking produk untuk event.")}
                  target="_blank"
                  rel="noreferrer"
                >
                  Booking via WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="paket-event">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Paket Event Unggulan</p>
              <h2>Pilih Paket, Tim Kami Siapkan Semua</h2>
            </div>
            <p class="section-note">
              Setiap paket otomatis tersusun ke Rencana Anggaran Event — tinggal sesuaikan jumlah.
            </p>
          </div>

          <div class="package-grid">
            {packages.map((pkg) => (
              <article class="package-card">
                <div class="package-tags">
                  {pkg.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <h3>{pkg.name}</h3>
                <p>{pkg.description}</p>
                <dl class="package-meta">
                  <div>
                    <dt>Estimasi Pax</dt>
                    <dd>{pkg.estimated_pax}</dd>
                  </div>
                  <div>
                    <dt>Estimasi Biaya</dt>
                    <dd>{formatPrice(pkg.estimatedTotal)}</dd>
                  </div>
                </dl>
                <ul class="package-items">
                  {pkg.items.slice(0, 4).map((item) => (
                    <li>{item.name}</li>
                  ))}
                  {pkg.items.length > 4 && <li class="more">+{pkg.items.length - 4} item lainnya</li>}
                </ul>
                <button
                  class="btn btn-accent js-add-package"
                  type="button"
                  data-package={pkg.name}
                  data-items={JSON.stringify(pkg.items)}
                >
                  Pilih Paket Ini
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section-alt" id="katalog">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Katalog Lengkap</p>
              <h2>Cari &amp; Susun Kebutuhan Event Anda</h2>
            </div>
            <p class="section-note">
              {totalItems}+ produk siap sewa. Ketik nama produk atau pilih tag di bawah.
            </p>
          </div>

          <div class="catalog-toolbar">
            <div class="search-field">
              <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M10 4a6 6 0 1 0 0 12 6 6 0 0 0 0-12Zm8.7 14.3-3.4-3.4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                ></path>
              </svg>
              <input
                type="search"
                id="productSearch"
                placeholder="Cari produk, misalnya: sofa vip, podium, kursi tiffany..."
                aria-label="Cari produk"
              />
            </div>
            <div class="filter-chips" id="filterChips" role="group" aria-label="Filter kategori">
              {filterChips.map((chip, idx) => (
                <button type="button" class={`chip ${idx === 0 ? "is-active" : ""}`} data-filter={chip.toLowerCase()}>
                  {chip}
                </button>
              ))}
            </div>
          </div>

          <p class="empty-results" id="emptyResults">Tidak ada produk yang cocok. Coba kata kunci atau filter lain.</p>

          {grouped.map((group) => (
            <section class="category" id={`cat-${group.name.toLowerCase()}`}>
              <div class="category-head">
                <h3>{group.name}</h3>
                <span>{group.items.length} item</span>
              </div>
              <div class="product-grid">
                {group.items.map((item, idx) => (
                  <article
                    class="product-card"
                    style={`--i: ${idx % 12}`}
                    data-name={item.name.toLowerCase()}
                    data-category={item.category.toLowerCase()}
                    data-tags={item.tags.map((t) => t.toLowerCase()).join(" ")}
                  >
                    <div class="product-media">
                      <img src={withBase(item.image)} alt={item.name} loading="lazy" />
                    </div>
                    <div class="product-body">
                      <h4>{item.name}</h4>
                      {item.description && <p>{item.description}</p>}
                      <div class="product-meta">
                        <span class="price">{formatPrice(item.price)}</span>
                        <a
                          class="wa-link"
                          href={waLink(`Halo HR Production, saya mau sewa ${item.name}. Mohon info harga & ketersediaan.`)}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`Pesan ${item.name} via WhatsApp`}
                        >
                          WA
                        </a>
                      </div>
                      <button
                        class="btn btn-plan js-add-to-cart"
                        type="button"
                        data-name={item.name}
                        data-price={item.price}
                      >
                        + Tambah ke Rencana Event
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

      <section class="section" id="kepercayaan">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Mengapa BUMN &amp; Pemerintah Percaya Kami</p>
              <h2>Standar Operasional Tanpa Kompromi</h2>
            </div>
          </div>
          <div class="pillar-grid">
            {pillars.map((p) => (
              <div class="pillar-card">
                <div class="pillar-icon" set:html={p.icon} />
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer" id="kontak">
      <div class="container footer-grid">
        <div>
          <h3>HR PRODUCTION</h3>
          <p>
            Pusat solusi stage, booth, VIP seating, dan event production untuk BUMN, instansi
            pemerintah, dan korporasi di seluruh Indonesia.
          </p>
        </div>
        <div>
          <h4>Kontak</h4>
          <ul>
            <li>{phonePrimary}</li>
            <li>{email}</li>
            <li>{address}</li>
          </ul>
        </div>
        <div>
          <h4>Quick Action</h4>
          <div class="footer-actions">
            <a
              class="btn btn-accent"
              href={waLink("Halo HR Production, saya mau tanya ketersediaan produk.")}
              target="_blank"
              rel="noreferrer"
            >
              Chat WhatsApp
            </a>
            <a class="btn btn-ghost" href={withBase("/katalog.pdf")} target="_blank" rel="noreferrer">
              Download Katalog PDF
            </a>
          </div>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>© 2026 HR Production. All rights reserved.</span>
      </div>
    </footer>

    <div class="cart-widget" id="cartWidget">
      <div class="cart-drawer" id="cartDrawer">
        <div class="cart-drawer-head">
          <h3>Rencana Anggaran Event</h3>
          <button class="cart-close" id="cartClose" type="button" aria-label="Tutup">×</button>
        </div>
        <ul class="cart-list" id="cartList"></ul>
        <p class="cart-empty" id="cartEmpty">Belum ada item. Pilih paket atau tambahkan produk dari katalog.</p>
        <div class="cart-drawer-foot">
          <div class="cart-total-row">
            <span>Total Estimasi</span>
            <strong id="cartTotal">Rp 0</strong>
          </div>
          <button class="btn btn-accent btn-block" id="cartSendWa" type="button" disabled>
            Kirim Rencana Event via WhatsApp
          </button>
          <button class="btn btn-text" id="cartClear" type="button">Kosongkan Rencana</button>
        </div>
      </div>
      <button class="cart-bar" id="cartBarToggle" type="button" aria-expanded="false" aria-controls="cartDrawer">
        <span class="cart-bar-icon" aria-hidden="true">🧾</span>
        <span><strong id="cartBarCount">0</strong> item · <span id="cartBarTotal">Rp 0</span></span>
        <span class="cart-bar-label">Rencana Event</span>
      </button>
    </div>

    <a
      class="float-wa"
      href={waLink("Halo HR Production, saya mau sewa produk untuk event.")}
      target="_blank"
      rel="noreferrer"
      aria-label="Chat WhatsApp"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.5 14.4c-.3-.1-1.7-.8-2-1-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1-1.3-.6-2.2-1.1-3.1-2.5-.2-.3 0-.5.1-.6.2-.2.4-.5.6-.7.1-.2.1-.4 0-.6-.1-.2-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9 1-.9 2.3 0 1.4 1 2.7 1.2 2.9.2.2 1.9 3 4.7 4.1 2.3.9 2.7.7 3.2.7.5-.1 1.6-.7 1.8-1.3.2-.6.2-1.1.1-1.3-.1-.1-.3-.2-.6-.3Z"/>
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l4.9-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/>
      </svg>
    </a>

    <script define:vars={{ waNumber }}>
      const cart = new Map();

      const searchInput = document.getElementById("productSearch");
      const chips = Array.from(document.querySelectorAll("#filterChips .chip"));
      const productCards = Array.from(document.querySelectorAll(".product-card"));
      const categorySections = Array.from(document.querySelectorAll(".category"));
      const emptyResults = document.getElementById("emptyResults");

      const cartList = document.getElementById("cartList");
      const cartEmpty = document.getElementById("cartEmpty");
      const cartTotalEl = document.getElementById("cartTotal");
      const cartSendWa = document.getElementById("cartSendWa");
      const cartClear = document.getElementById("cartClear");
      const cartBarCount = document.getElementById("cartBarCount");
      const cartBarTotal = document.getElementById("cartBarTotal");
      const cartBarToggle = document.getElementById("cartBarToggle");
      const cartDrawer = document.getElementById("cartDrawer");
      const cartClose = document.getElementById("cartClose");
      const navToggle = document.getElementById("navToggle");
      const siteNav = document.getElementById("siteNav");
      const heroSimulate = document.getElementById("heroSimulate");

      let activeFilter = "semua";

      function formatIDR(n) {
        return "Rp " + Math.round(n).toLocaleString("id-ID");
      }

      function escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, (c) => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[c]));
      }

      function openDrawer() {
        cartDrawer.classList.add("is-open");
        cartBarToggle.setAttribute("aria-expanded", "true");
      }

      function closeDrawer() {
        cartDrawer.classList.remove("is-open");
        cartBarToggle.setAttribute("aria-expanded", "false");
      }

      function toggleDrawer() {
        if (cartDrawer.classList.contains("is-open")) {
          closeDrawer();
        } else {
          openDrawer();
        }
      }

      function pulseBar() {
        cartBarToggle.classList.remove("is-pulsing");
        // restart animation
        void cartBarToggle.offsetWidth;
        cartBarToggle.classList.add("is-pulsing");
      }

      function addToCart(name, price, qty) {
        const existing = cart.get(name);
        if (existing) {
          existing.qty += qty || 1;
        } else {
          cart.set(name, { name, price: Number(price), qty: qty || 1 });
        }
        renderCart();
        pulseBar();
      }

      function cartTotals() {
        let count = 0;
        let total = 0;
        cart.forEach((item) => {
          count += item.qty;
          total += item.qty * item.price;
        });
        return { count, total };
      }

      function renderCart() {
        const items = Array.from(cart.values());
        const { count, total } = cartTotals();

        cartBarCount.textContent = String(count);
        cartBarTotal.textContent = formatIDR(total);
        cartTotalEl.textContent = formatIDR(total);
        cartSendWa.disabled = items.length === 0;

        cartEmpty.classList.toggle("is-visible", items.length === 0);

        cartList.innerHTML = items
          .map(
            (item) => `
            <li class="cart-item" data-name="${escapeHtml(item.name)}">
              <div class="cart-item-info">
                <strong>${escapeHtml(item.name)}</strong>
                <span>${formatIDR(item.price)} / unit</span>
              </div>
              <button class="cart-item-remove" type="button" data-action="remove" aria-label="Hapus ${escapeHtml(item.name)}">×</button>
              <div class="cart-item-qty">
                <button type="button" data-action="dec" aria-label="Kurangi jumlah">−</button>
                <span>${item.qty}</span>
                <button type="button" data-action="inc" aria-label="Tambah jumlah">+</button>
              </div>
              <div class="cart-item-subtotal">${formatIDR(item.price * item.qty)}</div>
            </li>`
          )
          .join("");
      }

      cartList.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-action]");
        if (!button) return;
        const row = button.closest(".cart-item");
        const name = row?.dataset.name;
        if (!name) return;
        const item = cart.get(name);
        if (!item) return;

        if (button.dataset.action === "inc") {
          item.qty += 1;
        } else if (button.dataset.action === "dec") {
          item.qty -= 1;
          if (item.qty <= 0) cart.delete(name);
        } else if (button.dataset.action === "remove") {
          cart.delete(name);
        }
        renderCart();
      });

      document.querySelectorAll(".js-add-to-cart").forEach((button) => {
        button.addEventListener("click", () => {
          addToCart(button.dataset.name, button.dataset.price, 1);
          openDrawer();
        });
      });

      document.querySelectorAll(".js-add-package").forEach((button) => {
        button.addEventListener("click", () => {
          let items = [];
          try {
            items = JSON.parse(button.dataset.items || "[]");
          } catch (err) {
            items = [];
          }
          items.forEach((item) => addToCart(item.name, item.price, 1));
          openDrawer();
        });
      });

      cartBarToggle.addEventListener("click", toggleDrawer);
      cartClose.addEventListener("click", closeDrawer);
      cartClear.addEventListener("click", () => {
        cart.clear();
        renderCart();
      });

      cartSendWa.addEventListener("click", () => {
        const items = Array.from(cart.values());
        if (items.length === 0) return;
        const { total } = cartTotals();
        const lines = items.map((item) => `- ${item.name} x ${item.qty}: ${formatIDR(item.price * item.qty)}`);
        const message = `Halo HR Production, saya ingin mengajukan penawaran sewa perlengkapan event:\n${lines.join(
          "\n"
        )}\nTotal Estimasi: ${formatIDR(total)}\nMohon info ketersediaan tanggal acara.`;
        window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`, "_blank", "noopener");
      });

      if (heroSimulate) {
        heroSimulate.addEventListener("click", () => {
          document.getElementById("paket-event")?.scrollIntoView({ behavior: "smooth", block: "start" });
          openDrawer();
        });
      }

      navToggle.addEventListener("click", () => {
        const isOpen = siteNav.classList.toggle("is-open");
        navToggle.setAttribute("aria-expanded", String(isOpen));
      });

      siteNav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          siteNav.classList.remove("is-open");
          navToggle.setAttribute("aria-expanded", "false");
        });
      });

      function applyFilters() {
        const query = searchInput.value.trim().toLowerCase();
        let visibleCount = 0;

        productCards.forEach((card) => {
          const name = card.dataset.name || "";
          const category = card.dataset.category || "";
          const tags = card.dataset.tags || "";
          const matchesQuery = !query || name.includes(query) || category.includes(query);
          const matchesFilter =
            activeFilter === "semua" || category === activeFilter || tags.split(" ").includes(activeFilter);
          const visible = matchesQuery && matchesFilter;
          card.classList.toggle("is-hidden", !visible);
          if (visible) visibleCount += 1;
        });

        categorySections.forEach((section) => {
          const anyVisible = section.querySelectorAll(".product-card:not(.is-hidden)").length > 0;
          section.classList.toggle("is-hidden", !anyVisible);
        });

        emptyResults.classList.toggle("is-visible", visibleCount === 0);
      }

      searchInput.addEventListener("input", applyFilters);

      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          chips.forEach((c) => c.classList.remove("is-active"));
          chip.classList.add("is-active");
          activeFilter = chip.dataset.filter;
          applyFilters();
        });
      });

      renderCart();
    </script>
  </body>
</html>
