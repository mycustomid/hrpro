---
import SolutionPage from "../components/SolutionPage.astro";
import catalogSource from "../data/catalog.json";
import { normalizeCatalog } from "../lib/catalog.mjs";
const catalog = normalizeCatalog(catalogSource);
const ids = ["sofa-oval-putih", "kursi-armchair-classic", "podium-lambang-garuda", "rope-stand-gold-vip"];
const products = ids.map((id) => catalog.find((product) => product.id === id)).filter(Boolean);
const needs = [{ title: "Hierarki tamu", body: "Area kehormatan, jalur kedatangan, dan posisi utama harus terbaca tanpa mengganggu alur peserta." }, { title: "Bahasa visual formal", body: "Furniture, podium, pembatas, dan detail ruang perlu menyatu dengan format protokoler." }, { title: "Administrasi terstruktur", body: "Daftar kebutuhan, perubahan kuantitas, dokumentasi, invoice, dan pajak disiapkan sebagai bagian dari alur kerja." }];
const response = [{ step: "Kunci format", body: "Petakan agenda, profil tamu, venue, kapasitas, serta titik protokol." }, { step: "Susun zona", body: "Pisahkan kebutuhan panggung, VVIP, peserta, registrasi, dan pendukung operasional." }, { step: "Konfirmasi eksekusi", body: "Selaraskan akses loading, jadwal setup, pengecekan, serah terima, dan pickup." }];
---
<SolutionPage eyebrow="Corporate · BUMN · Government" title="Formal di depan. Terkendali di belakang." intro="Infrastruktur event untuk rapat kerja, seremoni, kunjungan pejabat, agenda BUMN, dan kegiatan pemerintahan yang membutuhkan presentasi formal serta koordinasi rapi." description="Rental furniture dan perlengkapan event corporate, BUMN, pemerintahan, dan protokoler di Jabodetabek bersama HR Production." canonicalPath="/event-corporate-pemerintah" needs={needs} response={response} products={products} catalogQuery="?use=BUMN" schemaName="Event Corporate & Pemerintah" schemaDescription="Penyediaan furniture dan perlengkapan untuk acara corporate, BUMN, pemerintah, dan protokoler di Jabodetabek." signal="corporate" />
