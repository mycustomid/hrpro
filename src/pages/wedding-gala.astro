---
import SolutionPage from "../components/SolutionPage.astro";
import catalogSource from "../data/catalog.json";
import { normalizeCatalog } from "../lib/catalog.mjs";
const catalog = normalizeCatalog(catalogSource);
const ids = ["kursi-tiffany-gold", "meja-round-table-160cm-cover", "sofa-oval-putih", "karpet-permadani"];
const products = ids.map((id) => catalog.find((product) => product.id === id)).filter(Boolean);
const needs = [{ title: "Konsistensi suasana", body: "Pilihan bentuk, warna, dan material perlu menyambung dari area penerima hingga ruang utama." }, { title: "Kepadatan tamu", body: "Layout meja dan kursi harus menjaga kapasitas tanpa mengorbankan jalur layanan serta kenyamanan." }, { title: "Pergantian presisi", body: "Waktu loading, styling, pemeriksaan, dan pickup perlu mengikuti agenda venue serta vendor lain." }];
const response = [{ step: "Terjemahkan konsep", body: "Padankan mood, palet, format jamuan, kapasitas, dan kebutuhan area kehormatan." }, { step: "Uji komposisi", body: "Susun kombinasi seating, table, lounge, serta item pendukung dalam kuantitas yang relevan." }, { step: "Sinkronkan venue", body: "Konfirmasi akses, jadwal setup, koordinasi vendor, pemeriksaan akhir, dan pickup." }];
---
<SolutionPage eyebrow="Wedding · Gala · Hospitality" title="Suasana berkelas. Operasi tetap disiplin." intro="Furniture dan perlengkapan untuk wedding, gala dinner, penghargaan, dan jamuan formal—disusun agar suasana, kapasitas, dan kerja venue tetap selaras." description="Rental furniture wedding, gala dinner, dan acara hospitality di Jakarta, Tangerang Selatan, serta Jabodetabek." canonicalPath="/wedding-gala" needs={needs} response={response} products={products} catalogQuery="?use=Wedding" schemaName="Wedding & Gala" schemaDescription="Penyediaan furniture dan perlengkapan untuk wedding, gala dinner, dan hospitality event di Jabodetabek." signal="wedding" />
